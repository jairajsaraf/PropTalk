# Any OpenAI-compatible chat completions endpoint.
# Default: Gemini's OpenAI-compatible endpoint.
# LLM_API_BASE=https://generativelanguage.googleapis.com/v1beta/openai

# the LLM endpoint API key (required)
LLM_API_KEY=your_api_key_here

# Model id to use with the endpoint above.
# LLM_MODEL=gemini-2.5-flash

# SQL Server (optional — omit these to run in CSV demo mode)
# SQL_SERVER=your_server_here
# SQL_DATABASE=your_db_here
# SQL_TRUSTED_CONNECTION=yes
# SQL_USER=
# SQL_PASSWORD=
